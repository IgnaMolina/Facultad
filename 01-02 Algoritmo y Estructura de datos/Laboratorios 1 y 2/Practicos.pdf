Practico 1
esCero :: Int -> Bool
esCero n | n==0 = True
         | n/=0 = False

esPositivo :: Int -> Bool 
esPositivo n | n>0 = True
             | n<=0 = False

esVocal :: Char -> Bool
esVocal 'a' = True
esVocal 'e' = True
esVocal 'i' = True
esVocal 'o' = True
esVocal 'u' = True
esVocal c = False

valorAbsoluto :: Int -> Int
valorAbsoluto n | n>=0 = n
                | n<0 = n*(-1)

productoria :: [Int] -> Int
productoria [] = 1
productoria (x:xs) = x * productoria xs 

paraTodo :: [Bool] -> Bool
paraTodo [] = True
paraTodo (x:xs) | x==True = paraTodo xs
                | x==False = False

sumatoria :: [Int] -> Int
sumatoria [] = 0
sumatoria (x:xs) = x + sumatoria xs



esmul :: Int -> Int -> Bool
esmul x y = mod y x == 0

hayMultiplo :: Int -> [Int] -> Bool
hayMultiplo x ys = existe ys (esmul x)

{- Programar la funci ́on existeDivisor::Int-> [Int] -> Bool, que dado en entero n y una lista ls ,
devuelve True si y solo si, existe alg ́un elemento en ls que divida a na. -}


divide :: Int -> Int -> Bool
divide x y = mod x y == 0

existeDivisor :: Int-> [Int] -> Bool
existeDivisor n ls = existe ls (divide n)

{-Utilizando la funcion del apartado anterior, definı la funcion esPrimo:: Int -> Bool, que dado un entero
n, devuelve True si y solo si n es primo. Ayuda: En Haskell se puede escribir la lista que contiene el rango de
n ́umeros entre n y m como [n..m].
-}

esPrimo:: Int -> Bool
esPrimo n = existeDivisor n [2..n-1] == False

esprimo:: Int -> Int
esprimo n | existeDivisor n [2..n-1]  = 1
          | otherwise = n

{-factorial :: Int -> Int, que toma un n ́umero n y calcula n!.-}

factor :: Int -> Int
factor x = productoria [1..x] id

{-Programar la funci ́on multiplicaPrimos :: [Int] -> Int que calcula el producto de todos los n ́umeros
primos de una lista.-}

multiplicaPrimos :: [Int] -> Int
multiplicaPrimos (x:xs) = productoria (x:xs) esprimo

{-Programar la funci ́on esFib :: Int -> Bool, que dado un entero n, devuelve True si y s ́olo si n est ́a en la
sucesi ́on de Fibonacci. Ayuda: Realizar una funci ́on auxiliar fib :: Int -> Int que dado un n devuelva el
n- ́esimo elemento de la sucesi ́on.-}

fib :: Int -> Int
fib 0 = 0
fib 1 = 1
fib x = fib (x - 1) + fib (x - 2)

esFib :: Int -> Bool
esFib n = existe [0..n+1] (\x -> fib x == n)

{-Utilizando la funci ́on del apartado anterior, defin ́ı la funci ́on todosFib :: [Int] -> Bool que dada una
lista xs de enteros, devuelva si todos los elementos de la lista pertenecen (o no) a la sucesi ́on de Fibonacci.-}

todosFib :: [Int] -> Bool
todosFib xs = paratodo xs esFib

Practico 2

esCero :: Int -> Bool
esCero 0 = True
esCero _ = False

esCero2 :: Int -> Bool
esCero2 n | n==0 = True
          | n/=0 = False

esCero3 :: Int -> Bool
esCero3 0 = True
esCero3 n = False

esPositivo :: Int -> Bool
esPositivo x = x > 0

esVocal :: Char -> Bool
esVocal 'a' = True
esVocal 'e' = True
esVocal 'i' = True
esVocal 'o' = True
esVocal 'u' = True
esVocal n = False

valorAbsoluto :: Int -> Int
valorAbsoluto n | n>=0 = n               
                | n<0 = -n
                 
productoria :: [Int] -> Int
productoria [] = 1
productoria (n:ns) = n * productoria ns

 
 
todoIguales :: [Int] -> Bool
todoIguales [] = True
todoIguales (x:[]) = True
todoIguales (x:(y:ys)) = x==y && todoIguales (y:ys)

--4)
maximo :: [Int] -> Int
maximo [] = error "La lista está vacía."
maximo xs = maximum xs

minimo :: [Int] -> Int
minimo [] = error "La lista está vacía."
minimo xs = minimum xs

compara :: [Int] -> [Int] -> Bool
compara (x:xs) (y:ys)  | maximo xs >= minimo ys = False
                       | maximo xs < minimo ys = True
                       
-- xs = [−3, 9, 8], ys = [6, 7, 8]. =False

--5)

todos :: [Bool] -> Bool
todos [] = True
todos(x:xs) = x == todos xs && x == True


porDos :: [Int] -> [Int]
porDos [] = []
porDos (x:xs) = x*2 : porDos xs

map1 :: (a -> b) -> [a] -> [b]
map1 f [] = []
map1 f (x:xs) = f x : map1 f xs



sonmenoresa3 :: [Int] -> [Bool]
sonmenoresa3 [] = []
sonmenoresa3 (x:xs) = (x<3) : sonmenoresa3 xs

filter1 :: (a -> Bool) -> [a] -> [a]
filter1 f [] = []
filter1 f (x:xs) | f x = x : filter1 f xs
                 | otherwise = filter1 f xs

